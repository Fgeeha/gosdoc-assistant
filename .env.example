# Скопируйте в .env и задайте свои значения. .env в git не попадает.
POSTGRES_PASSWORD=change-me-postgres-password-20+
RABBITMQ_PASSWORD=change-me-rabbitmq-password-20+
# Пароль администратора (логин admin) для первого входа; потребуется сменить.
GOSDOC_ADMIN_PASSWORD=Change-me-admin-2026
HTTP_PORT=8080

# Хранилище файлов: s3 | postgres | local
STORAGE_BACKEND=s3

# Реальная модель вместо mock (OpenAI-совместимый API в контуре):
# LLM_BASE_URL=https://inference.fgau.local/v1
# LLM_MODEL=
# LLM_API_KEY=
# LLM_MAX_CONTEXT=8192
# EMBEDDINGS_BASE_URL=
# EMBEDDINGS_MODEL=

# Локальный корневой CA для TLS к сервисам *.fgau.local:
# CA_BUNDLE=/etc/gosdoc/ca.pem

# Регламентные задачи Airflow → /api/internal/* (32+ символов; пусто — отключено):
# SERVICE_TOKEN=
# MLFLOW_URL=
# MLFLOW_TOKEN=
